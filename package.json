{
  "name": "kairos-v5-physical-control-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "audit:legacy:minecraft-hierarchical-short-chain-live-v1": "npm run build --silent && node scripts/run-minecraft-hierarchical-short-chain-live-v1.mjs",
    "audit:legacy:minecraft-hierarchical-button-door-live-v1": "npm run build --silent && node scripts/run-minecraft-hierarchical-button-door-live-v1.mjs",
    "audit:legacy:minecraft-hierarchical-multilevel-goal-chain-live-v1": "npm run build --silent && node scripts/run-minecraft-hierarchical-multilevel-goal-chain-live-v1.mjs",
    "audit:legacy:minecraft-hierarchical-continuous-bridge-continuation-live-v1": "npm run build --silent && node scripts/run-minecraft-hierarchical-continuous-bridge-continuation-live-v1.mjs",
    "g5:neutral:canary": "npm run build --silent && node scripts/run-distributed-g5-neutral-control-v1.mjs --mode canary",
    "g5:neutral:matrix": "npm run build --silent && node scripts/run-distributed-g5-neutral-control-v1.mjs --mode matrix",
    "minecraft:distributed-g6-continuous-capture-v1": "npm run build --silent && node scripts/run-minecraft-distributed-g6-continuous-capture-v1.mjs",
    "audit:legacy:minecraft-guided-affordance": "node scripts/run-minecraft-guided-affordance-evaluation.mjs",
    "audit:legacy:minecraft-joint-control-heldout-v2": "node scripts/run-minecraft-joint-control-heldout-v2.mjs",
    "audit:legacy:minecraft-note-recursive-qualification-v1": "node scripts/run-minecraft-note-recursive-qualification-v1.mjs",
    "audit:legacy:minecraft-multilevel-guided-live-v1": "npm run build --silent && node scripts/run-minecraft-multilevel-guided-training-live-v1.mjs",
    "audit:legacy:minecraft-multilevel-foundation-live-v1": "npm run build --silent && node scripts/run-minecraft-multilevel-foundation-live-v1.mjs",
    "audit:legacy:minecraft-multilevel-goal-chain-live-v1": "npm run build --silent && node scripts/run-minecraft-multilevel-goal-chain-live-v1.mjs",
    "audit:legacy:minecraft-multilevel-ablations-live-v1": "npm run build --silent && node scripts/run-minecraft-multilevel-ablations-live-v1.mjs",
    "audit:legacy:rebuild-attempt017-physical-memory-v2": "node scripts/rebuild-attempt017-physical-memory-v2.mjs",
    "audit:attempt017-direction-conditions-v1": "node scripts/audit-attempt017-direction-conditions-v1.mjs",
    "audit:minecraft-multilevel-goal-chain-v1": "npm run build --silent && node scripts/audit-minecraft-multilevel-goal-chain-v1.mjs",
    "audit:legacy:test-minecraft-multilevel-goal-chain-v1": "npm run build --silent && node --test dist/test/minecraft-multilevel-goal-chain-v1.test.js",
    "audit:legacy:test-minecraft-note-recursive-qualification-v1": "npm run build --silent && node --test dist/test/minecraft-note-recursive-qualification-v1.test.js",
    "audit:legacy:test-minecraft-multilevel-guided-training-live-v1": "npm run build --silent && node --test dist/test/minecraft-multilevel-guided-training-live-v1.test.js",
    "audit:legacy:test-minecraft-multilevel-goal-chain-live-v1": "npm run build --silent && node --test dist/test/minecraft-multilevel-goal-chain-live-v1.test.js",
    "verify": "npm run build && npm test"
  },
  "dependencies": {
    "mineflayer": "4.37.1",
    "prismarine-block": "1.23.0",
    "prismarine-viewer": "1.33.0",
    "prismarine-world": "3.7.0",
    "vec3": "0.1.10"
  },
  "devDependencies": { "typescript": "5.9.3", "@types/node": "24.12.0" }
}
